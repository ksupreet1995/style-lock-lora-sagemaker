# Copy to .env and fill in your own values. Do not commit .env.
#
#   cp .env.example .env
#   # edit .env, then:
#   set -a; source .env; set +a
#
# NOTE ON YOUR AWS ACCOUNT
# There is no "account id" setting. It is resolved at runtime from whichever
# credentials you are using (sts:GetCallerIdentity), so it is never written
# into any file in this repo. The only place your account id appears is
# inside the role ARN below, and this file's .env copy is gitignored.
#
# Point at an account by configuring credentials the usual way:
#   aws configure                 # long-lived keys
#   aws sso login --profile foo   # IAM Identity Center
#   export AWS_PROFILE=foo
# Then confirm with:
#   aws sts get-caller-identity

# Required -------------------------------------------------------------------

AWS_REGION=us-east-2

# An IAM role SageMaker can assume. Must allow SageMaker + S3 access;
# AmazonSageMakerFullAccess is the simplest starting point.
# Find existing candidates with:
#   aws iam list-roles --query "Roles[?contains(RoleName,'SageMaker')].Arn"
SAGEMAKER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/service-role/YOUR-EXECUTION-ROLE

# Required only for the MLflow scripts (07, 08, 13, 17, 18, 19, 20, 22) ------

# Name of a SageMaker managed MLflow tracking server. List yours with:
#   aws sagemaker list-mlflow-tracking-servers
MLFLOW_TRACKING_SERVER=

# Optional -------------------------------------------------------------------

# Defaults to the account's SageMaker session bucket.
# S3_BUCKET=
# S3_PREFIX=sdxl-lora-demo

# MLFLOW_EXPERIMENT=sdxl-lora-style-lock
# MODEL_PACKAGE_GROUP=sdxl-lora-flatgem-style

# INSTANCE_TYPE=ml.g5.2xlarge
# INSTANCE_HOURLY_USD=1.515

# Override DLC image URIs only if the SDK cannot resolve them for your region.
# TRAINING_IMAGE_URI=
# INFERENCE_IMAGE_URI=
